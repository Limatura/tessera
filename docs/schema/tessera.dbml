// Generated by scripts/schema-docs.py. Do not edit.
// Paste into https://dbdiagram.io to see it laid out.

Project tessera {
  database_type: 'SQLite'
  Note: 'The same tables on PostgreSQL and MySQL; only the types differ.'
}

Table access_events {
  id text [pk, not null]
  share_id text [not null]
  occurred_at text [not null]
  ip_address text
  user_agent text

  Note: '誰在什麼時候取走了哪一份分享。預設不寫——計數器是一個整數,不會透露誰去過哪裡;這裡的一列是位址加瀏覽器字串,關於一個拿到連結、什麼都沒答應過的人。匿名是有人選這套軟體的理由之一,所以把它關掉是操作者的決定,不是預設值幫他做的。開了要在頁面上講,被記錄的人是最後一個知道的。ip_address 可以是 NULL——前面掛著不受信任的 proxy 時,看得到的位址是 proxy 的,記下去等於記錯人。'
}

Table api_token_permissions {
  token_id text [pk, not null]
  permission text [pk, not null]

  Note: '一張 token 能做什麼。實際生效的是這裡跟主人權限的交集,所以主人被降權,他手上的 token 同時就窄了。'
}

Table api_tokens {
  id text [pk, not null]
  user_id text [not null]
  name text [not null]
  secret_hash text [not null, unique]
  display_prefix text [not null]
  created_at text [not null]
  last_used_at text
  expires_at text
  revoked_at text

  Note: '給程式用的憑證。只存摘要,原始值發出去之後就不再存在。'
}

Table file_shares {
  id text [pk, not null]
  share_id text [not null]
  position integer [not null]
  filename text
  content_type text
  size_bytes integer [not null]
  storage text [not null]
  object_key text
  created_at text [not null]

  Note: '檔案分享的每一個檔案。現在一次分享一列,#42 之後會是多列,`position` 就是為此存在的。'
}

Table invites {
  id text [pk, not null]
  code_hash text [not null, unique]
  note text
  max_uses integer [not null]
  used integer [not null]
  created_at text [not null]
  expires_at text

  Note: '邀請碼。同樣只存摘要。'
}

Table password_reset_tokens {
  id text [pk, not null]
  user_id text [not null]
  secret_hash text [not null, unique]
  created_at text [not null]
  expires_at text [not null]
  used_at text

  Note: '重設密碼的一次性連結。'
}

Table pending_registrations {
  id text [pk, not null]
  username text [not null]
  email text [not null, unique]
  password_hash text [not null]
  secret_hash text [not null, unique]
  created_at text [not null]
  expires_at text [not null]
  invite_id text

  Note: '還沒驗證的註冊。帳號在信件被點開之前不存在,所以資料先放這裡——這樣「這個 email 註冊了沒」問不出來。'
}

Table role_permissions {
  role_id text [pk, not null]
  permission text [pk, not null]

  Note: '角色包含哪些權限。權限本身是程式定義的,不是資料——沒有人檢查的權限給了也是空的。'
}

Table roles {
  id text [pk, not null]
  name text [not null, unique]
  description text
  is_system integer [not null]
  created_at text [not null]
  updated_at text [not null]

  Note: '一組權限的名字。誰能做什麼只由這裡決定,沒有別的地方。'
}

Table schema_metadata {
  key text [pk, not null]
  value text [not null]
  updated_at integer [not null]

  Note: '這個資料庫是哪一版寫的。降版啟動時用來擋下來。'
}

Table sessions {
  id text [pk, not null]
  user_id text [not null]
  secret_hash text [not null, unique]
  created_at text [not null]
  last_seen_at text [not null]
  expires_at text [not null]
  created_ip text
  created_user_agent text
  ended_reason text

  Note: '一次登入。過期了也留著,因為這張表同時是登入紀錄——使用者要看得出有沒有別人進來過。真正的清除靠 `auth.login_history_days`。'
}

Table share_tickets {
  id text [pk, not null]
  share_id text [not null]
  secret_hash text [not null, unique]
  created_at text [not null]
  expires_at text [not null]

  Note: '輸對密碼之後拿到的通行證。存在的理由是「看得到」和「拿得到」要分開——預覽頁不該花掉一次取用次數。'
}

Table shares {
  id text [pk, not null]
  code text [not null, unique]
  user_id text
  kind text [not null]
  password_hash text
  use_limit integer
  use_count integer [not null]
  expires_at text
  disabled_at text
  title text
  og_config text
  management_token_hash text
  view_count integer [not null]
  last_accessed_at text
  created_at text [not null]
  updated_at text [not null]
  copy_count integer [not null]
  bytes_served integer [not null]

  Note: '一次分享,不管內容是什麼。取用碼、密碼、次數、到期都在這裡,因為那些規則跟內容是什麼無關。內容完全不在這裡——它在 file_shares 和 text_shares,因為一份分享可以有好幾個檔案,而欄位裝不下「好幾個」。bytes_served 是「離開這個 process 的位元組」,不是「到達使用者的」——前面掛 proxy 的話它握著的那一小段會被多算,而 CDN 快取掉的請求根本不會被看到。'
}

Table text_shares {
  share_id text [pk, not null]
  language text
  content blob [not null]

  Note: '文字分享的內容本身。`content` 不可為空——「文字的內容在別的地方」正是這張表要消滅的狀態。'
}

Table upload_parts {
  upload_id text [pk, not null]
  part_number integer [pk, not null]
  content_id text [not null]

  Note: '分片上傳裡 store 已經收下的每一片。存著是因為 complete_multipart 要把每一片原封不動交回去,而沒有一種列法是三家雲端都同意的。本地檔案系統不會有這裡的列——它用 append。'
}

Table uploads {
  id text [pk, not null]
  share_id text
  user_id text
  token_hash text [not null]
  filename text
  content_type text
  declared_bytes integer [not null]
  offset_bytes integer [not null]
  object_key text [not null]
  multipart_id text
  created_at text [not null]
  updated_at text [not null]
  expires_at text [not null]

  Note: '還在傳的檔案。一份還沒傳完的東西不是 file_shares 的一列——那張表的每一列都代表「拿得到的內容」,而這裡的東西還拿不到。object_key 開檔時就決定,之後不再重算,因為續傳要能接回同一個位置。declared_bytes 是客戶端宣告的大小,配額算的是這個而不是已經到的,不然兩個人可以同時宣告用光同一份空間。'
}

Table user_roles {
  user_id text [pk, not null]
  role_id text [pk, not null]
  granted_at text [not null]

  Note: '誰在哪些角色裡。沒有任何一列 = 登入了但什麼都不能做,那是真的狀態不是錯誤。'
}

Table users {
  id text [pk, not null]
  username text [not null, unique]
  email text [not null, unique]
  password_hash text [not null]
  must_change_password integer [not null]
  email_verified_at text
  created_at text [not null]
  updated_at text [not null]
  state text [not null]
  deleted_at text
  deleted_by text

  Note: '帳號。刪掉的不會消失,只會變成一列洗乾淨的殘骸——因為 shares.user_id 指著它,而「沒有人上傳過」和「上傳的人不在了」是兩件不同的事。'
}

