#!/bin/sh

# ultracite

set -u

# ------------------------------------------------------------
# Get staged files
# ------------------------------------------------------------

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

# ------------------------------------------------------------
# Only pass source files to Ultracite.
#
# Do not duplicate Ultracite's own ignore rules here.
# This only prevents non-source files such as:
#   *.md
#   *.mdx
#   *.json
#   *.yaml
#   *.yml
#   lockfiles
#   .husky/*
# from being passed as explicit targets.
# ------------------------------------------------------------

SOURCE_FILES=""

while IFS= read -r file; do
  [ -z "$file" ] && continue

  # Skip deleted files
  [ -f "$file" ] || continue

  case "$file" in
    *.js|*.jsx|*.mjs|*.cjs|\
    *.ts|*.tsx|*.mts|*.cts|\
    *.css)
      SOURCE_FILES="${SOURCE_FILES}
${file}"
      ;;
  esac
done <<EOF
$STAGED_FILES
EOF

# ------------------------------------------------------------
# Nothing for Ultracite to process
# ------------------------------------------------------------

if [ -z "$SOURCE_FILES" ]; then
  echo "No staged source files to format"
  exit 0
fi

# ------------------------------------------------------------
# Run Ultracite only on staged source files
# ------------------------------------------------------------

FORMAT_EXIT_CODE=0

echo "✨ Running Ultracite on staged files..."

while IFS= read -r file; do
  [ -z "$file" ] && continue

  echo "→ $file"

  if ! pnpm exec ultracite fix "$file"; then
    FORMAT_EXIT_CODE=1
  fi
done <<EOF
$SOURCE_FILES
EOF

# ------------------------------------------------------------
# Re-stage files modified by Ultracite
# ------------------------------------------------------------

while IFS= read -r file; do
  [ -z "$file" ] && continue

  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done <<EOF
$SOURCE_FILES
EOF

# ------------------------------------------------------------
# Result
# ------------------------------------------------------------

if [ "$FORMAT_EXIT_CODE" -ne 0 ]; then
  echo ""
  echo "❌ Ultracite found issues that could not be auto-fixed."
  exit "$FORMAT_EXIT_CODE"
fi

echo ""
echo "✨ Files formatted by Ultracite"

exit 0

# ultracite end