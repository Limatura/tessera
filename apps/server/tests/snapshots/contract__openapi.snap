---
source: apps/server/tests/contract.rs
expression: document
---
{
  "components": {
    "schemas": {
      "AccessEventResponse": {
        "description": "One recorded retrieval, as an administrator sees it.",
        "properties": {
          "ip_address": {
            "description": "Where the request came from, or `null` when there was no honest answer.\n\nBehind a proxy this instance does not trust, the address it can see is\nthe proxy's. A null says so; the proxy's own address would be a record\nof the wrong person.",
            "example": "203.0.113.9",
            "type": [
              "string",
              "null"
            ]
          },
          "occurred_at": {
            "description": "When the content was handed over, RFC 3339.",
            "example": "2026-08-22T09:41:00Z",
            "type": "string"
          },
          "user_agent": {
            "description": "What the client called itself, as presented and truncated.",
            "example": "Mozilla/5.0",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "occurred_at"
        ],
        "type": "object"
      },
      "AccessLogResponse": {
        "description": "A share's recorded retrievals.",
        "properties": {
          "enabled": {
            "description": "Whether this instance is recording at all.\n\nAn empty list means two different things — nobody has fetched it, or\nnothing is being written down — and a screen that cannot tell them apart\nwill report the second as the first.",
            "type": "boolean"
          },
          "events": {
            "description": "The events, most recent first.",
            "items": {
              "$ref": "#/components/schemas/AccessEventResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "enabled",
          "events"
        ],
        "type": "object"
      },
      "AccountResponse": {
        "description": "An account, as the API describes it. Never carries a hash.",
        "properties": {
          "email": {
            "description": "Normalised address.",
            "example": "alice@example.com",
            "type": "string"
          },
          "id": {
            "description": "Stable identifier.",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "is_admin": {
            "description": "Whether the account holds the seeded administrator role.\n\nKept because clients read it. It is now derived rather than stored, and\nit answers a narrower question than `permissions` does — somebody in a\nrole that grants `users:read` and nothing else is not an administrator\nbut can still reach one administrative endpoint. New clients should read\n`permissions`.",
            "type": "boolean"
          },
          "must_change_password": {
            "description": "Whether the account must set a new password before doing anything else.\n\nSet on the administrator generated at first run. A client seeing this\nshould send the user to a change-password screen and nowhere else.",
            "type": "boolean"
          },
          "permissions": {
            "description": "Everything this account is allowed to do.\n\n`resource:verb` strings. The set a client should decide what to show\nfrom — a screen that guesses from `is_admin` will be wrong for every\nrole between \"member\" and \"everything\".",
            "example": [
              "shares:create",
              "shares:read"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "roles": {
            "description": "The roles it is in, by name.",
            "example": [
              "member"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "username": {
            "description": "Normalised account name.",
            "example": "alice",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "is_admin",
          "permissions",
          "roles",
          "must_change_password"
        ],
        "type": "object"
      },
      "AdminSharePage": {
        "description": "A page of shares.",
        "properties": {
          "shares": {
            "description": "The shares on this page.",
            "items": {
              "$ref": "#/components/schemas/AdminShareResponse"
            },
            "type": "array"
          },
          "total": {
            "description": "How many exist in total, so a client can render pagination.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "shares",
          "total"
        ],
        "type": "object"
      },
      "AdminShareResponse": {
        "description": "One share, as an administrator sees it.\n\nDeliberately not the same shape a person sees of their own: this listing\nexists to find things that need removing, so it carries who uploaded it and\nhow big it is, and it never carries the retrieval code. An administrator who\ncan read every code can open every share, and that is a different power from\nbeing able to delete one.",
        "properties": {
          "active": {
            "description": "Whether a visitor could still open it.",
            "type": "boolean"
          },
          "bytes_served": {
            "description": "How many bytes it has sent out, over its whole life.\n\nThe instance-wide figure in `StatsResponse` answers \"what is this\ncosting me\"; this answers the question that follows it, which is which\nshare to do something about. One link posted somewhere busy is the way\nan operator finds out their transfer is being spent, and the total\ncannot say which one.\n\nNot `size_bytes` times `use_count`: a range request, a resumed download\nand an abandoned one all send some other amount.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "created_at": {
            "description": "When it was uploaded, RFC 3339.",
            "type": "string"
          },
          "expires_at": {
            "description": "When it stops being served, RFC 3339, or `null` if it never does.",
            "type": [
              "string",
              "null"
            ]
          },
          "file_count": {
            "description": "How many files it holds. Zero for text.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "filename": {
            "description": "What the uploader called it, when the share holds exactly one file.\n\n`null` for text and for a share with several — see `file_count`.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Stable identifier, for [`delete_share`].",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "kind": {
            "description": "Whether it holds a file or text.",
            "example": "file",
            "type": "string"
          },
          "owner_id": {
            "description": "Who uploaded it, or `null` when nobody was signed in.\n\nAn account that has since been deleted still appears here — the row it\nleft behind is what keeps this answerable. `null` means the upload was\nanonymous, which is a different fact and worth telling apart.",
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "description": "How many bytes it holds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "file_count",
          "size_bytes",
          "bytes_served",
          "active",
          "created_at"
        ],
        "type": "object"
      },
      "AdminUserResponse": {
        "$ref": "#/components/schemas/AccountResponse",
        "description": "One account, as an administrator sees it.\n\nThe same shape a person sees of themselves. There is nothing extra to show:\nthis service stores no profile, and the one thing an administrator can change\nis already a field."
      },
      "Capabilities": {
        "description": "Body of `GET /api/v1/capabilities`.\n\n# Why this endpoint exists\n\n`openapi.json` is a build artefact: it describes every endpoint the software\nhas. Which of them an *instance* exposes is a runtime decision its operator\nmade. A single-page app generated from the contract therefore cannot know\nwhether to render a login button — the contract says login exists, and on\nthis deployment it may not.\n\nSo the contract describes the whole surface and this reports the subset in\nforce. It is deliberately unauthenticated: a client needs the answer before\nit can know whether logging in is even possible.",
        "properties": {
          "access_log": {
            "description": "Whether this instance writes down who fetches a share.\n\n`false` by default. When it is `true`, every retrieval records the\nvisitor's address and browser string, and the visitor is the person that\nhappens to — so a client should say so on the page where the share is\ncollected. Nobody else is going to tell them.",
            "type": "boolean"
          },
          "account_password_min_length": {
            "description": "Shortest *account* password this instance accepts, so a client can say so\nbefore the round trip rather than after it.\n\nNamed for what it governs because there are two minimums and they are\ndeliberately different — see\n[`share_password_min_length`](Self::share_password_min_length).",
            "example": 12,
            "minimum": 0,
            "type": "integer"
          },
          "accounts": {
            "description": "Whether accounts exist at all on this instance.\n\n`false` means there is no registration, no login and no session — the\nshape for a personal instance behind a VPN.",
            "type": "boolean"
          },
          "admin": {
            "description": "Whether the administrative endpoints are mounted.\n\nThe administration front-end is a separate deployment, so this says only\nthat the API half is present.",
            "type": "boolean"
          },
          "anonymous_upload": {
            "description": "Whether a caller without a session may upload.\n\nIndependent of [`accounts`](Self::accounts): an instance can have\naccounts *and* accept anonymous uploads, which is the default.",
            "type": "boolean"
          },
          "default_expiry_hours": {
            "description": "How long a share lasts when the uploader does not choose, in hours.\n\nThe upload form needs this to say what \"leave it alone\" means. `null`\nwhen this instance lets shares live forever by default.",
            "example": 168,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_expiry_hours": {
            "description": "The longest lifetime an uploader may ask for, in hours.\n\n`null` when there is no ceiling. A form that knows this can bound its own\ncontrol instead of letting somebody pick a date the server will refuse.",
            "example": 8760,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_upload_bytes": {
            "description": "Longest accepted request body, in bytes.",
            "example": 104857600,
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "password_reset": {
            "description": "Whether this instance can send a password reset link.\n\n`false` when no relay is configured, which is the default. A client that\ndraws the \"forgot password\" link regardless would send people to an\nendpoint that answers 404 — so this is the difference between a missing\nfeature and a broken one.",
            "type": "boolean"
          },
          "registration": {
            "$ref": "#/components/schemas/RegistrationPolicy",
            "description": "Who may create an account. Meaningless when\n[`accounts`](Self::accounts) is `false`."
          },
          "registration_requires_confirmation": {
            "description": "Whether registering sends a confirmation link rather than creating the\naccount outright.\n\n`true` means `POST /auth/register` answers `202` and nothing exists\nuntil the address is confirmed — so a client must show \"check your\ninbox\" rather than treating the response as a sign-in. `false` means it\nanswers `201` with a session, which is what an instance that sends no\nmail does.",
            "type": "boolean"
          },
          "share_password_min_length": {
            "description": "Shortest password an uploader may put on a share.\n\nLower than the account minimum on purpose: a share password is a second\nfactor on a link that is already unguessable, and it gets read out over\nthe phone. A form that validated share passwords against the account\nrule would refuse the four-digit code the server would have accepted.",
            "example": 4,
            "minimum": 0,
            "type": "integer"
          },
          "storage_remaining_bytes": {
            "description": "How much of the instance's storage quota is left, in bytes.\n\n`null` for everyone but an administrator, and also for an administrator\nwhen the instance has no quota set.\n\nOnly an administrator, because on a public instance this is the\noperator's capacity planning and not the visitor's business: telling\nevery anonymous uploader how close the disk is to full invites somebody\nto close the gap. An uploader who exceeds it gets a `507` naming the\nlimit, which is the moment they actually need to know.",
            "example": 53687091200,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "version": {
            "description": "Version of the running server, for a client that wants to warn about a\nmismatch with the contract it was generated from.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "accounts",
          "admin",
          "anonymous_upload",
          "registration",
          "account_password_min_length",
          "share_password_min_length",
          "registration_requires_confirmation",
          "password_reset",
          "access_log",
          "max_upload_bytes",
          "version"
        ],
        "type": "object"
      },
      "ChangePasswordRequest": {
        "description": "Body of `PATCH /auth/password`.",
        "properties": {
          "current_password": {
            "description": "The password in force now. Required even though the caller is signed in:\nit is what stops a borrowed, unlocked browser from taking the account.",
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          },
          "new_password": {
            "description": "The replacement.",
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "type": "object"
      },
      "Consequence": {
        "description": "What a setting change would destroy the next time the sweep runs.\n\n# Why this exists\n\nThree settings are retention periods, and shortening one means the next\nsweep removes things that were going to be kept. Nothing warns about it and\nnothing brings them back.\n\nAn empty \"are you sure?\" does not help — everybody clicks it. A number does:\n\"this removes 23 shares, 4.2 GB\" is a sentence somebody stops at.",
        "properties": {
          "bytes": {
            "description": "How many bytes of stored content go with them, when that applies.",
            "example": 4500000000,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "count": {
            "description": "How many.",
            "example": 23,
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "key": {
            "description": "Which setting causes it.",
            "example": "share.retain_after_death_hours",
            "type": "string"
          },
          "subject": {
            "description": "What would go, as a plural noun a screen can print.",
            "example": "shares",
            "type": "string"
          }
        },
        "required": [
          "key",
          "subject",
          "count"
        ],
        "type": "object"
      },
      "CreateInviteRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /admin/invites`.",
        "properties": {
          "expires_in_days": {
            "description": "How many days it lasts, or `null` for one that never expires.",
            "example": 7,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "note": {
            "description": "What to call it, so a list of them means something.",
            "example": "family",
            "type": [
              "string",
              "null"
            ]
          },
          "uses": {
            "description": "How many accounts this code may create.\n\nOne code with several places is what the feature is for: something to\nsend to a group rather than a code per person. `1` makes it single-use.",
            "example": 3,
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "uses"
        ],
        "type": "object"
      },
      "CreateTokenRequest": {
        "description": "Body of `POST /tokens`.",
        "properties": {
          "expires_in_days": {
            "description": "How long the token should last, in days. Omit for a token that lives\nuntil it is revoked.",
            "example": 90,
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "A label for the token, so its owner can recognise it later.",
            "example": "backup script",
            "type": "string"
          },
          "permissions": {
            "description": "What the token may do, as `resource:verb` strings.\n\nOmitted means `shares:create` and nothing else — a token exists to\nupload, and the default that is wrong in the safe direction is the one\nthat has to be widened on purpose. The other default would hand every\nscreenshot tool the ability to delete everything its owner has.\n\nA permission the caller does not hold is refused: a token cannot be a\nway to exceed the account that minted it.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatedInviteResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/InviteResponse",
            "description": "The invite itself."
          },
          {
            "properties": {
              "code": {
                "description": "**Shown once.** Only its SHA-256 digest is stored, so this value cannot\nbe read back afterwards — not by an administrator, not by anybody.",
                "example": "3f9a1c…",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "A freshly minted invite, with its code."
      },
      "CreatedTokenResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenResponse",
            "description": "The token's metadata, identical to what a listing returns."
          },
          {
            "properties": {
              "secret": {
                "description": "The secret, in full.\n\n**Shown once.** Only its SHA-256 digest is stored, so this value cannot be\nrecovered — a client that does not keep it has to issue another token.",
                "example": "tsk_a1b2c3d4e5f6...",
                "type": "string"
              }
            },
            "required": [
              "secret"
            ],
            "type": "object"
          }
        ],
        "description": "A newly issued token. The only response that ever carries the secret."
      },
      "DeleteAccountRequest": {
        "additionalProperties": false,
        "description": "Body of `DELETE /account`.",
        "properties": {
          "current_password": {
            "description": "The password in force now, for the same reason as above.",
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          },
          "delete_shares": {
            "description": "Whether to end everything this account uploaded.\n\nDefaults to ending it. For a file courier, \"delete my account\" usually\nmeans \"and the things I sent\" — and somebody who wants the links they\nhanded out to keep working is the rarer case, worth one explicit `false`.\n\n# What \"delete\" means here\n\nEvery link stops working the moment this returns. The bytes go later,\nwhen the housekeeping pass reaches them — removing hundreds of objects\ninside one request is a request that times out half way through with no\nrecord of where it got to.\n\nSo the content does go, and nothing serves it in the meantime; what\narrives after the answer is the disk space.",
            "type": "boolean"
          }
        },
        "required": [
          "current_password"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The JSON body returned for every non-2xx response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable identifier the client can branch on."
          },
          "message": {
            "description": "Human-readable explanation. Never contains internal details.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable, machine-readable identifier for an [`Error`].\n\nClients branch on this; the human-readable `message` is free to change.",
        "enum": [
          "not_found",
          "bad_request",
          "payload_too_large",
          "unauthorized",
          "forbidden",
          "password_change_required",
          "gone",
          "range_not_satisfiable",
          "conflict",
          "too_many_requests",
          "insufficient_storage",
          "unsupported_media_type",
          "timeout",
          "unavailable",
          "internal"
        ],
        "type": "string"
      },
      "HealthResponse": {
        "description": "Body of a successful `GET /health`.",
        "properties": {
          "build_rev": {
            "description": "Commit the running binary was built from, or `unknown` outside a git\ncheckout. Between releases this is what identifies a build.",
            "example": "v0.1.0-3-gab12cd34ef56",
            "type": "string"
          },
          "database": {
            "description": "Relational backend currently in use.",
            "example": "sqlite",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ServiceStatus",
            "description": "Where the process is in its lifecycle."
          },
          "uptime_seconds": {
            "description": "Whole seconds since the process started.",
            "example": 3600,
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "description": "Version of the running binary.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "build_rev",
          "uptime_seconds",
          "database"
        ],
        "type": "object"
      },
      "InviteResponse": {
        "description": "One invite code, as an administrator sees it.\n\nNever carries the code. Only its digest is stored, so there is nothing to\nshow — see [`CreatedInviteResponse`] for the one moment there is.",
        "properties": {
          "active": {
            "description": "Whether it would still admit somebody.\n\nSent rather than left to the client to work out from `used`, `max_uses`\nand `expires_at` against its own clock — the same reason a session says\nwhether it is active.",
            "type": "boolean"
          },
          "created_at": {
            "description": "When it was made.",
            "type": "string"
          },
          "expires_at": {
            "description": "When it stops working, or `null` for one that does not.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Stable identifier, for revoking it.",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "max_uses": {
            "description": "How many accounts it may create.",
            "format": "int64",
            "type": "integer"
          },
          "note": {
            "description": "What the operator called it.",
            "type": [
              "string",
              "null"
            ]
          },
          "used": {
            "description": "How many it has created.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "max_uses",
          "used",
          "active",
          "created_at"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "description": "Body of `POST /auth/login`.",
        "properties": {
          "identifier": {
            "description": "Username or email address; either is accepted.",
            "example": "alice",
            "type": "string"
          },
          "password": {
            "description": "The account's password.\n\nBounded by what any instance could ever have accepted rather than by the\npolicy in force, so that raising the minimum cannot lock out an account\nwhose password was valid when it was chosen.",
            "example": "correct horse battery staple",
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "type": "object"
      },
      "PasswordResetConfirmRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /auth/password-reset/confirm`.",
        "properties": {
          "password": {
            "description": "What to set the password to.",
            "type": "string"
          },
          "token": {
            "description": "The token from the link.",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "PasswordResetRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /auth/password-reset`.",
        "properties": {
          "email": {
            "description": "The address to send the link to.",
            "example": "someone@example.com",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "PatchShareRequest": {
        "additionalProperties": false,
        "description": "Body of `PATCH /shares/{code}`.\n\nEvery field is optional and omitting one leaves that setting alone. Sending\n`null` clears it — absent and null are different instructions here.\n\nThe password is deliberately not here. It travels in `X-Share-Password`, the\nsame header the rest of this API uses, because a body is not the problem —\nthe problem is every other place a value can end up, and a header is the one\nchannel that stays out of the query string, the access log and the\n`Referer`. What is here is only the instruction to remove it, which is not a\nsecret.",
        "properties": {
          "expires_in_hours": {
            "description": "How long from now the share should last. `null` means it stops expiring.",
            "example": 24,
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_uses": {
            "description": "How many more times it may be retrieved. `null` means unlimited.\n\nCounted against the retrievals it has already had, so lowering this\nbelow `use_count` retires the share rather than reviving it.",
            "example": 1,
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "remove_password": {
            "description": "Removes the share's password.\n\nSetting one is `X-Share-Password`; this is the other direction. Sending\nboth is refused rather than guessed at.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "PermissionResponse": {
        "description": "Every permission this version has, so a screen can offer them.\n\nSent rather than hard-coded in the client: a client listing permissions it\nwas built against would silently stop offering ones added since, and the\noperator would have no way to grant them.",
        "properties": {
          "name": {
            "description": "The `resource:verb` string.",
            "example": "users:read",
            "type": "string"
          },
          "privileged": {
            "description": "Whether it reaches beyond the holder's own things.\n\nThe question an operator is actually asking of a role they are about to\ngrant: does this let them touch other people?",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "privileged"
        ],
        "type": "object"
      },
      "PreviewResponse": {
        "description": "What `POST /admin/settings/preview` answers.",
        "properties": {
          "consequences": {
            "description": "What the change would destroy. Empty when it destroys nothing.",
            "items": {
              "$ref": "#/components/schemas/Consequence"
            },
            "type": "array"
          }
        },
        "required": [
          "consequences"
        ],
        "type": "object"
      },
      "PublicShareResponse": {
        "description": "A share as a public visitor sees it.\n\nEverything but `code`, `kind` and `has_password` is withheld until the share\nis unlocked. A file name and a size are a description of the content, and a\npassword-protected share should not describe itself to somebody who has not\npresented the password — the same reason its link preview must not.",
        "properties": {
          "code": {
            "description": "The retrieval code.",
            "example": "0ZPQ4M7K",
            "type": "string"
          },
          "created_at": {
            "description": "When it was created, RFC 3339.",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "description": "When it stops being served, RFC 3339.",
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "description": "Every file this share holds. Empty for text and for a locked share.",
            "items": {
              "$ref": "#/components/schemas/SharedFile"
            },
            "type": "array"
          },
          "has_password": {
            "description": "Whether a password must be presented before anything else is revealed.",
            "type": "boolean"
          },
          "kind": {
            "description": "`text` or `file`.",
            "example": "file",
            "type": "string"
          },
          "language": {
            "description": "Syntax-highlighting hint.",
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "description": "Size of the content in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "description": "Display name.",
            "type": [
              "string",
              "null"
            ]
          },
          "unlocked": {
            "description": "Whether the fields below are filled in.",
            "type": "boolean"
          },
          "uses_remaining": {
            "description": "How many retrievals remain, or `null` for unlimited.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "kind",
          "has_password",
          "unlocked",
          "files"
        ],
        "type": "object"
      },
      "RegisterConfirmRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /auth/register/confirm`.",
        "properties": {
          "token": {
            "description": "The token from the link.",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "RegisterRequest": {
        "description": "Body of `POST /auth/register`.",
        "properties": {
          "email": {
            "description": "Address to reach the account at.",
            "example": "alice@example.com",
            "format": "email",
            "type": "string"
          },
          "invite_code": {
            "description": "An invite code, on an instance that asks for one.\n\nIgnored where registration is open, so a client does not have to know\nwhich kind of instance it is talking to before filling in the form.\n`/capabilities` says which it is.",
            "example": "3f9a1c…",
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "description": "At least `password_min_length` characters — see `/capabilities`.",
            "example": "correct horse battery staple",
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          },
          "username": {
            "description": "3–32 characters: letters, digits, `_` and `-`, starting with a letter or\ndigit. Stored lowercased.",
            "example": "alice",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ],
        "type": "object"
      },
      "RegistrationPolicy": {
        "description": "Who may create an account.",
        "enum": [
          "open",
          "invite",
          "closed"
        ],
        "type": "string"
      },
      "RemovedSharesResponse": {
        "description": "How many shares an operation ended.",
        "properties": {
          "removed": {
            "description": "How many were still live and are now finished.\n\nThe bytes go as the reaper reaches them, so this number is not how much\nspace came back yet.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "removed"
        ],
        "type": "object"
      },
      "RoleRequest": {
        "description": "Body of `POST /admin/roles` and `PUT /admin/roles/{id}`.",
        "properties": {
          "description": {
            "description": "What it is for.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "What to call it.",
            "type": "string"
          },
          "permissions": {
            "description": "Everything it should allow, as `resource:verb` strings.\n\nThe whole set, not a change to it. Two operators editing the same role\nfrom two screens cannot interleave their edits into a set neither of\nthem chose — the last one to press save wins, visibly.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "permissions"
        ],
        "type": "object"
      },
      "RoleResponse": {
        "description": "One role, as the API describes it.",
        "properties": {
          "created_at": {
            "description": "When it was created, RFC 3339.",
            "type": "string"
          },
          "description": {
            "description": "What it is for, in the operator's own words.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Stable identifier.",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "is_system": {
            "description": "Whether it is one of the two the instance was seeded with.\n\nThose cannot be deleted — an instance whose administrator role has been\nremoved has nobody who can create one. They can still be edited.",
            "type": "boolean"
          },
          "members": {
            "description": "How many accounts are in it.\n\nThe number an operator wants before editing one: changing a role that\nnobody holds is free, and changing one that forty people hold is not.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "What an operator types and reads.",
            "example": "auditor",
            "type": "string"
          },
          "permissions": {
            "description": "What it allows, as `resource:verb` strings.",
            "example": [
              "users:read"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "description": "When its permissions last changed, RFC 3339.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "is_system",
          "permissions",
          "members",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ServiceStatus": {
        "description": "Where the process is in its lifecycle.\n\nLoad balancers and `docker healthcheck` need to distinguish \"still migrating\"\nfrom \"draining\" from \"healthy\"; a bare 200/500 cannot express that.",
        "enum": [
          "starting",
          "ready",
          "draining"
        ],
        "type": "string"
      },
      "SessionResponse": {
        "description": "One sign-in, as the API describes it.\n\nCovers sessions that are over as well as the ones that work. Somebody reading\nthis list is usually asking whether anybody else has been in, and a session\nthat was revoked last Tuesday is exactly what they need to see.",
        "properties": {
          "active": {
            "description": "Whether it still works.\n\nSent rather than left to the client to derive from `expires_at`: a\nbrowser's clock can be wrong by more than a session's remaining life, and\nbeing told \"this is still live\" by a machine with a fast clock is how\nsomebody decides not to revoke something they should have.",
            "type": "boolean"
          },
          "created_at": {
            "description": "When the sign-in happened.",
            "type": "string"
          },
          "created_ip": {
            "description": "Where the sign-in came from, when there was an answer worth recording.\n\n`null` on an instance that sits behind an undeclared proxy, and on\nsessions that predate this being recorded.",
            "example": "203.0.113.9",
            "type": [
              "string",
              "null"
            ]
          },
          "created_user_agent": {
            "description": "The `User-Agent` the sign-in arrived with, exactly as it was sent.\n\nNot parsed into \"Chrome on macOS\": doing that reliably is famously hard,\nand getting it wrong tells somebody a session is theirs when it is not.",
            "example": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) Safari/605.1.15",
            "type": [
              "string",
              "null"
            ]
          },
          "current": {
            "description": "Whether this is the session reading the list.\n\nThe one thing a person cannot work out for themselves, and the one they\nneed before ending anything.",
            "type": "boolean"
          },
          "ended_reason": {
            "description": "Why it ended early, if somebody ended it.\n\n`null` means it simply ran out. The values are `signed_out`, `revoked`,\n`password_changed`, `password_reset` and `account_disabled`.",
            "example": "revoked",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "description": "When it stops, or stopped, working.",
            "type": "string"
          },
          "id": {
            "description": "Stable identifier, for [`revoke`].",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "last_seen_at": {
            "description": "When this session was last used.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "current",
          "active",
          "created_at",
          "last_seen_at",
          "expires_at"
        ],
        "type": "object"
      },
      "SettingResponse": {
        "description": "One setting, as the panel draws it.",
        "properties": {
          "editable": {
            "description": "Whether this endpoint will change it.",
            "type": "boolean"
          },
          "key": {
            "description": "Dotted key, the same spelling the file and the environment use.",
            "example": "share.code_length",
            "type": "string"
          },
          "refusal": {
            "description": "Why it will not, when it will not.\n\n`fixed_at_boot` for something the running process cannot pick up,\n`secret` for something that holds a credential. Present so a screen can\nexplain rather than only grey the field out.",
            "example": "fixed_at_boot",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Source",
            "description": "Which layer supplied it."
          },
          "value": {
            "description": "The value in force.",
            "type": "object"
          }
        },
        "required": [
          "key",
          "value",
          "source",
          "editable"
        ],
        "type": "object"
      },
      "SettingsResponse": {
        "description": "Everything this instance can be configured with.",
        "properties": {
          "settings": {
            "description": "Every setting, editable or not.",
            "items": {
              "$ref": "#/components/schemas/SettingResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "ShareBody": {
        "description": "The request body of `POST /shares`: the content itself, as bytes.\n\nA named type only so the contract can say `format: binary`. Declaring the\nbody as `Vec<u8>` makes utoipa emit an *array of integers*, which a docs UI\nrenders as a JSON array editor and a generated client types as `number[]` —\nneither of which can carry a file.\n\nAn empty body is refused with a `400`, and that rule is *not* expressible\nhere: `min_length` is a field-level attribute, and the field's own schema is\noverridden by the `value_type` above — which has to stay, or the body stops\nbeing binary. So the constraint lives in the handler and is documented as a\nresponse, and a generator reading this will believe an empty body is valid.",
        "format": "binary",
        "type": "string"
      },
      "ShareEventRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /shares/{code}/events`.",
        "properties": {
          "kind": {
            "description": "What happened: `view` or `copy`.\n\nRetrieval is deliberately not one of these — see [`record_event`].",
            "example": "view",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "SharePage": {
        "description": "A page of the caller's shares.",
        "properties": {
          "shares": {
            "description": "The shares on this page.",
            "items": {
              "$ref": "#/components/schemas/ShareResponse"
            },
            "type": "array"
          },
          "total": {
            "description": "How many the caller has in total, so a client can render pagination.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "shares",
          "total"
        ],
        "type": "object"
      },
      "ShareResponse": {
        "description": "A share as the API describes it. Never carries the content.",
        "properties": {
          "code": {
            "description": "The retrieval code, as a person reads it.",
            "example": "0ZPQ4M7K",
            "type": "string"
          },
          "copy_count": {
            "description": "How many times a client reported it being copied.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "created_at": {
            "description": "When it was created, RFC 3339.",
            "type": "string"
          },
          "expires_at": {
            "description": "When it stops being served, RFC 3339, or `null` to live until deleted.",
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "description": "Every file this share holds. Empty for text and for a locked share.",
            "items": {
              "$ref": "#/components/schemas/SharedFile"
            },
            "type": "array"
          },
          "has_password": {
            "description": "Whether a password must be presented to retrieve it.",
            "type": "boolean"
          },
          "id": {
            "description": "Stable identifier.",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "kind": {
            "description": "`text` or `file`.",
            "example": "file",
            "type": "string"
          },
          "language": {
            "description": "Syntax-highlighting hint.",
            "type": [
              "string",
              "null"
            ]
          },
          "last_accessed_at": {
            "description": "When it was last retrieved, RFC 3339.\n\nThe answer to the question somebody actually asks of their own share:\nhas the person I sent this to picked it up yet?",
            "type": [
              "string",
              "null"
            ]
          },
          "management_token": {
            "description": "Token that lets an anonymous uploader delete this share.\n\n**Shown once, at creation, and only when nobody was signed in.** Only its\ndigest is stored. Without it a mistaken anonymous upload could never be\ntaken back.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Where the share lives, relative to this instance's origin.\n\nRelative on purpose: the server does not know what host it is reached\nthrough, and guessing wrong behind a reverse proxy produces links that\ndo not work. Whoever calls this already knows the origin they called.",
            "example": "/s/0ZPQ4M7K",
            "type": "string"
          },
          "size_bytes": {
            "description": "Size of the content in bytes.",
            "example": 1048576,
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "Display name.",
            "type": [
              "string",
              "null"
            ]
          },
          "use_count": {
            "description": "How many times it has been retrieved.\n\nCounted by the server on the transfer path, so it is the number to\ntrust — the two below are what a client told us.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "uses_remaining": {
            "description": "How many retrievals remain, or `null` for unlimited.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "view_count": {
            "description": "How many times a client reported showing it.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "code",
          "path",
          "kind",
          "files",
          "size_bytes",
          "has_password",
          "use_count",
          "view_count",
          "copy_count",
          "created_at"
        ],
        "type": "object"
      },
      "SharedFile": {
        "description": "One file in a share, as the API describes it.",
        "properties": {
          "filename": {
            "description": "What it was uploaded as.",
            "example": "holiday.jpg",
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "description": "Its position in the share, from zero.\n\nSent rather than left to the array's order: a client that sorts or\nfilters the list still has the uploader's order to put it back in.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "size_bytes": {
            "description": "How many bytes it holds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "position",
          "size_bytes"
        ],
        "type": "object"
      },
      "Source": {
        "description": "Which layer a setting's value came from.",
        "enum": [
          "default",
          "environment",
          "panel"
        ],
        "type": "string"
      },
      "StatsResponse": {
        "description": "What one instance is holding, at a glance.\n\n# Why this is not a metrics endpoint\n\nFour numbers an operator can act on, not a time series. \"Am I near the\nquota\", \"how many people are on here\", \"is the sweep keeping up\" — the\nquestions somebody asks before deciding whether to change a setting. Anything\nthat wants graphs wants Prometheus, and that is a different endpoint with a\ndifferent shape.",
        "properties": {
          "accounts": {
            "description": "How many accounts exist.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "administrators": {
            "description": "How many of those administer the instance.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "bytes_served": {
            "description": "How many bytes this instance has sent out.\n\nBytes that left the process, not bytes that reached anybody — a proxy in\nfront holds some, and a caching CDN answers requests this never sees.\nFor what crossed the network, a reverse proxy's own log is the authority.\n\nCounted over the shares still here: a swept share takes its tally with\nit, so this falls when one goes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "live_invites": {
            "description": "How many invites could still admit somebody.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "live_shares": {
            "description": "How many a visitor could still open.\n\nThe gap between this and `shares` is what the sweep has not reached yet,\nwhich is worth seeing: a large one means retention is longer than\nsomebody expected, or the sweep is not running.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "quota_bytes": {
            "description": "The ceiling from `storage.max_total_bytes`, or `null` when unset.\n\n`null` is not \"unlimited\" so much as \"nobody said\" — and on an instance\nthat takes anonymous uploads, that is the combination the start-up\nwarning is about.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "shares": {
            "description": "How many shares exist, including ones nobody can open any more.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "stored_bytes": {
            "description": "Bytes of uploaded content still on the store.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "accounts",
          "administrators",
          "shares",
          "live_shares",
          "stored_bytes",
          "bytes_served",
          "live_invites"
        ],
        "type": "object"
      },
      "TicketResponse": {
        "description": "What `POST /shares/{code}/unlock` hands back.",
        "properties": {
          "expires_at": {
            "description": "When the authorisation stops being honoured, RFC 3339.",
            "type": "string"
          },
          "ticket": {
            "description": "Present it as `X-Share-Ticket`, or as `?t=` on a download link.",
            "example": "9f2c...",
            "type": "string"
          },
          "uses_remaining": {
            "description": "How many retrievals remain after this one.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "ticket",
          "expires_at"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "description": "An issued token, as a listing describes it. Never carries the secret.",
        "properties": {
          "created_at": {
            "description": "When it was issued, RFC 3339.",
            "type": "string"
          },
          "display_prefix": {
            "description": "Leading characters of the secret, so a person can tell two tokens apart\nwithout the service having to store either of them.",
            "example": "tsk_a1b2",
            "type": "string"
          },
          "expires_at": {
            "description": "When it stops being accepted, or `null` to live until revoked.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Stable identifier; what `DELETE /tokens/{id}` takes.",
            "example": "01K1ZQK9V8QF5S3T4M2N6P7R8S",
            "type": "string"
          },
          "last_used_at": {
            "description": "When it was last accepted, if ever.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "What the owner called it.",
            "example": "backup script",
            "type": "string"
          },
          "permissions": {
            "description": "What it may do, as `resource:verb` strings.\n\nWhat it was minted with, not what it can do right now — those differ\nwhen the owner has since been demoted, and the owner is who this list is\nfor. Sending the narrowed set instead would make a token look as though\nit had been quietly edited.",
            "example": [
              "shares:create"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "revoked_at": {
            "description": "When it was revoked, if it was.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "display_prefix",
          "permissions",
          "created_at"
        ],
        "type": "object"
      },
      "UpdateAccountRequest": {
        "additionalProperties": false,
        "description": "Body of `PATCH /account`.",
        "properties": {
          "current_password": {
            "description": "The password in force now.\n\nRequired even though the caller is signed in. An unlocked browser left\non a desk is otherwise enough to move the account's address to one the\nfinder controls, and from there the reset flow hands them the account.",
            "maxLength": 1024,
            "minLength": 8,
            "type": "string"
          },
          "email": {
            "description": "A new address, or omitted to keep the current one.\n\nChanging it clears the verification: the new address has not been proven\nreachable, and carrying the old flag over would mean an unverified\naddress wearing a verified one's badge.",
            "example": "alice@example.com",
            "format": "email",
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "description": "A new name, or omitted to keep the current one.",
            "example": "alice",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "current_password"
        ],
        "type": "object"
      },
      "UpdateSettingsRequest": {
        "additionalProperties": false,
        "description": "Body of `PUT /admin/settings`.",
        "properties": {
          "changes": {
            "description": "The changes to apply, by dotted key.\n\n`null` clears a setting, so it falls back to the environment, the file,\nor the default — whichever comes next. That is the only way back to a\nvalue the panel did not choose, and it is why clearing is a value rather\nthan a second endpoint.",
            "type": "object"
          },
          "confirm": {
            "description": "Go ahead even though the change destroys something.\n\nWithout it, a change that would remove things is refused and the answer\nsays what and how many. That is deliberately two round trips: an empty\n\"are you sure?\" is a button everybody clicks, and a number is what makes\nsomebody stop.",
            "type": "boolean"
          }
        },
        "required": [
          "changes"
        ],
        "type": "object"
      },
      "UpdateUserRequest": {
        "additionalProperties": false,
        "description": "Body of `PATCH /admin/users/{id}`.",
        "properties": {
          "is_admin": {
            "description": "Whether this account administers the instance.",
            "type": "boolean"
          },
          "state": {
            "description": "`active` to let it in, `disabled` to suspend it.\n\nOmitted leaves it as it is. `deleted` is refused here — removing an\naccount scrubs it, and that is `DELETE` rather than a field on a patch.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "is_admin"
        ],
        "type": "object"
      },
      "UploadResponse": {
        "description": "A session that has just been opened.",
        "properties": {
          "id": {
            "description": "Identifier, and the last segment of the URL to continue at.",
            "type": "string"
          },
          "length": {
            "description": "How much was declared.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "description": "How much has arrived. Zero, here.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "part_size": {
            "description": "How much to send per chunk, in bytes.\n\nA chunk that is not the last is accepted only up to a multiple of this;\nthe rest comes back as a lower offset and has to be re-sent. Sending\nexact multiples avoids that entirely.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "token": {
            "description": "Proof that a later request is the same uploader, for an anonymous one.\n\n**Store this.** It is shown once, and without it the upload cannot be\nresumed after the page is closed — which is the situation resuming\nexists for. `null` when the uploader is signed in, because their own\ncredential already answers the question.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "offset",
          "length",
          "part_size"
        ],
        "type": "object"
      },
      "UserRolesRequest": {
        "description": "Body of `PUT /admin/users/{id}/roles`.",
        "properties": {
          "roles": {
            "description": "The roles this account should be in. The whole list, not a change to it.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "roles"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "tsk_*",
        "description": "An API token from `POST /api/v1/tokens`, sent as `Authorization: Bearer tsk_…`. Shown once at creation.",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "description": "Set by `POST /auth/login`. A browser sends it automatically; it is `HttpOnly`, so page scripts cannot read or set it.",
        "in": "cookie",
        "name": "tessera_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Anonymous file courier. Upload a file or a note, hand out a retrieval code, and the payload destroys itself once it expires or runs out of retrievals.",
    "title": "Tessera API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account": {
      "delete": {
        "description": "# Why the shares are the caller's decision and not an administrator's\n\nThey are the person's own uploads. An administrator removing somebody else\ndoes not touch their content — that is a separate, explicit act — but\nsomebody removing themselves is entitled to say what happens to what they\nsent.\n\n# Errors\n\n`401` when the password is wrong, `403` when an API token was used or the\ncaller is the last one able to administer the instance.",
        "operationId": "delete_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The account is gone"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in, or the password is wrong"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Nobody would be left to administer the instance"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Removes the caller's own account.",
        "tags": [
          "auth"
        ]
      },
      "patch": {
        "description": "# Errors\n\n`400` when a value fails its rule, `401` when the password is wrong, `403`\nwhen an API token was used, `409` when the name or address is taken.",
        "operationId": "update_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "The account as it now stands"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A value is not usable"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in, or the password is wrong"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name or address is taken"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Changes the caller's own name or address.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/admin/invites": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when the caller is not an\nadministrator or used a bearer token, `404` when this instance has no\nadministration.",
        "operationId": "list_invites",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InviteResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every invite on this instance"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists every invite, newest first.",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "description": "# Why this exists when the CLI already does it\n\nThe command line is the rescue path — it works with the service stopped and\nneeds nothing but the database file. This is the ordinary path: somebody\nletting a friend in should not have to reach a shell on the box.\n\n# Errors\n\n`400` when `uses` is below one or the lifetime is beyond a calendar, `401`\nwhen nothing was signed in, `403` when the caller is not an administrator or\nused a bearer token, `404` when this instance has no administration.",
        "operationId": "create_invite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInviteResponse"
                }
              }
            },
            "description": "The invite, with its code"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A value failed its rule"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Mints an invite code and returns it, once.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/invites/{id}": {
      "delete": {
        "description": "The accounts it already admitted stay: an account created through a code does\nnot depend on the code still existing. What this stops is the code letting\nanybody else in, which is what somebody who posted one in the wrong chat\nwindow wants.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller is not an\nadministrator or used a bearer token, `404` when no invite has that\nidentifier.",
        "operationId": "revoke_invite",
        "parameters": [
          {
            "description": "Which invite to revoke",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "It no longer admits anybody"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No invite has that id"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Revokes an invite.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/permissions": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when the caller may not read roles\nor used a bearer token, `404` when this instance has no administration.",
        "operationId": "list_permissions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PermissionResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every permission this version has"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not read roles, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists every permission this version has.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/roles": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when the caller may not read roles\nor used a bearer token, `404` when this instance has no administration.",
        "operationId": "list_roles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RoleResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every role on this instance"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not read roles, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists every role, by name.",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "description": "# Why a caller cannot grant what they do not hold\n\nOtherwise `roles:write` is every permission: somebody holding only that\ncould mint a role granting `users:delete`, put themselves in it, and have\nit. The check makes `roles:write` mean \"may hand out what I have\" rather\nthan \"may hand out anything\".\n\n# Errors\n\n`400` when the name or a permission is not usable, `401` when nothing was\nsigned in, `403` when the caller may not write roles, used a bearer token,\nor asked for a permission they do not hold, `409` when the name is taken,\n`404` when this instance has no administration.",
        "operationId": "create_role",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleResponse"
                }
              }
            },
            "description": "The role as it now stands"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name or a permission is not usable"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not write roles, used an API token, or asked for a permission not held"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A role already has that name"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Creates a role.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/roles/{id}": {
      "delete": {
        "description": "Anybody in it stops being in it, which can leave somebody in no role at all\n— signed in and allowed nothing. That is a real state and not an error; the\nlisting shows how many people it would affect.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller may not write roles\nor used a bearer token, `404` when no role has that identifier, `409` when\nit is a seeded role or the last one able to administer the instance.",
        "operationId": "delete_role",
        "parameters": [
          {
            "description": "Which role",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "It is gone"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not write roles, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such role"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A seeded role, or nobody would be left to administer the instance"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Removes a role.",
        "tags": [
          "admin"
        ]
      },
      "put": {
        "description": "# Errors\n\n`400` when the name or a permission is not usable, `401` when nothing was\nsigned in, `403` when the caller may not write roles, used a bearer token,\nor asked for a permission they do not hold, `404` when no role has that\nidentifier, `409` when the name is taken or the change would leave nobody\nable to administer the instance.",
        "operationId": "update_role",
        "parameters": [
          {
            "description": "Which role",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleResponse"
                }
              }
            },
            "description": "The role as it now stands"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name or a permission is not usable"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not write roles, used an API token, or asked for a permission not held"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such role"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name is taken, or nobody would be left to administer the instance"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Replaces what a role allows.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/settings": {
      "get": {
        "description": "# Why the ones that cannot be changed are here too\n\nLeaving them out is what makes somebody ask where the port setting went.\nThey come back marked `editable: false` with a reason, which is a screen\nthat explains itself rather than one with a hole in it.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller may not read\nsettings or used a bearer token, `404` when this instance has no\nadministration.",
        "operationId": "list_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Every setting"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not read settings, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists every setting, with its value and where that value came from.",
        "tags": [
          "admin"
        ]
      },
      "put": {
        "description": "# Why the change is tried before it is stored\n\nA value this binary will not accept is refused here, with the key named,\nrather than written and quietly dropped at the next start-up. The start-up\nfallback exists so a bad row cannot make an instance unbootable — it is a\nsafety net, not the validation path, and letting the panel lean on it would\nmean a save that reports success and reverts on restart.\n\n# Why one request can carry several\n\nSettings that only make sense together — turning the access log on and\nsetting its retention — should not have a moment where one is applied and\nthe other is not. They are validated as a set, and stored only if the set\nloads.\n\n# Errors\n\n`400` for an unknown key, one that cannot be changed, or a value the\nconfiguration will not accept. `401`, `403` and `404` as for [`list`].",
        "operationId": "update_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            },
            "description": "Every setting, as it now stands"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A key or value this instance will not accept"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not change settings, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The change destroys something; the message says what, and `confirm` goes ahead"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Changes settings, and applies them.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/settings/preview": {
      "post": {
        "description": "# Errors\n\n`400` for a key or value this instance will not accept — the same answers\n[`update`] gives, so a client cannot get a clean preview for a change that\nwould then be refused.",
        "operationId": "preview_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            },
            "description": "What the change would destroy"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A key or value this instance will not accept"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not change settings, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Says what a change would destroy, without making it.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/shares": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when the caller may not read every\nshare or used a bearer token, `404` when this instance has no\nadministration.",
        "operationId": "list_all_shares",
        "parameters": [
          {
            "description": "How many to return. Capped, and defaulted when omitted.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "How many to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSharePage"
                }
              }
            },
            "description": "A page of shares"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`limit` or `offset` is not a number"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not read every share, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists every share on the instance, newest first.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/shares/{id}": {
      "delete": {
        "description": "# Why this exists\n\nThe ordinary delete route asks whether the caller owns the share. An upload\nfrom an account that has since been deleted is owned by nobody, so nothing\ncould remove it — it kept serving its content, kept its place in the storage\nquota, and was never swept if it had no expiry and no use limit. This is the\nonly way to reach one.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller may not delete every\nshare or used a bearer token, `404` when no share has that identifier.",
        "operationId": "delete_any_share",
        "parameters": [
          {
            "description": "Which share",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "It is gone"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not delete every share, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such share"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Removes any share, whoever uploaded it.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/shares/{id}/access-log": {
      "get": {
        "description": "# Why this is administrative and not the uploader's\n\nThe switch belongs to whoever runs the instance, so the record does too.\nHanding visitor addresses to every uploader would be a second decision about\nsomebody else's privacy, taken on behalf of an operator who only agreed to\nthe first — and on a shared instance the uploader is not the operator.\n\nIf an instance wants uploaders to see their own, that is a deliberate change\nto make, not one to arrive at by leaving this open.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller may not read every\nshare or used a bearer token, `404` when there is no such share or this\ninstance has no administration.",
        "operationId": "read_share_access_log",
        "parameters": [
          {
            "description": "Which share",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How many to return. Capped, and defaulted when omitted.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "How many to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessLogResponse"
                }
              }
            },
            "description": "What has been recorded"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`limit` or `offset` is not a number"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not read every share, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such share"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Reads who has fetched one share.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/stats": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when the caller is not an\nadministrator or used a bearer token, `404` when this instance has no\nadministration.",
