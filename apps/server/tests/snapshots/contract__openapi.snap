              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Reports what this instance is holding.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when the caller is not an\nadministrator or used a bearer token, `404` when this instance has no\nadministration.",
        "operationId": "list_users",
        "parameters": [
          {
            "description": "Include accounts that have been deleted.\n\nOff by default: what is left of one identifies nobody and cannot be\nacted on, so it belongs in an answer somebody asked for rather than in\nevery listing.",
            "in": "path",
            "name": "include_deleted",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every account on this instance"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no administration"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists every account, newest first.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/users/{id}": {
      "delete": {
        "description": "# What goes with it and what does not\n\nSessions and API tokens are deleted by the database. Shares are not: their\nowner column is `ON DELETE SET NULL`, so what somebody uploaded becomes an\nanonymous share and keeps working for whoever holds the code. Deleting an\naccount is about the account, and taking somebody's files off the internet in\nthe same motion would be a second decision made silently.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller is not an\nadministrator or used a bearer token, `404` when no account has that\nidentifier, `409` when this would leave the instance with no administrator.",
        "operationId": "delete_user",
        "parameters": [
          {
            "description": "Which account to remove",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No account has that id"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "That would leave the instance with no administrator"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Removes an account.",
        "tags": [
          "admin"
        ]
      },
      "patch": {
        "description": "# Why the last one cannot be removed\n\nAn instance with no administrator cannot be repaired through the API — there\nis no endpoint left that would let anybody grant the flag back. The way out\nis the command line against the database file, which an operator who locked\nthemselves out of a container may not have. So the case is refused rather\nthan allowed and regretted.\n\nRemoving your own flag while somebody else still has it is allowed: that is\na person stepping down, not an accident.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller is not an\nadministrator or used a bearer token, `404` when no account has that\nidentifier, `409` when this would leave the instance with none.",
        "operationId": "update_user",
        "parameters": [
          {
            "description": "Which account to change",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "The account as it now stands"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not an administrator, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No account has that id"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "That would leave the instance with no administrator"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Grants or removes the administrator flag.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/users/{id}/roles": {
      "put": {
        "description": "# Errors\n\n`400` when a role identifier is not one, `401` when nothing was signed in,\n`403` when the caller may not write roles, used a bearer token, or would be\ngranting a permission they do not hold, `404` when no such account or role,\n`409` when it would leave nobody able to administer the instance.",
        "operationId": "set_user_roles",
        "parameters": [
          {
            "description": "Which account",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRolesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "The account as it now stands"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not write roles, used an API token, or would grant a permission not held"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such account or role"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Nobody would be left to administer the instance"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Puts an account in exactly these roles.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/users/{id}/shares": {
      "delete": {
        "description": "# Why this is not part of deleting the account\n\nRemoving somebody and destroying what they uploaded are different acts. An\noperator clearing space wants this and not that; one removing a person who\nhas left wants that and not this. Welding them together would make one of\nthose two impossible and the other a surprise.\n\nIt works on an account in any state, including one still in use — an\noperator reclaiming space from somebody who is still here should not have to\nsuspend them first.\n\n# Errors\n\n`401` when nothing was signed in, `403` when the caller may not delete every\nshare or used a bearer token, `404` when no account has that identifier.",
        "operationId": "remove_user_shares",
        "parameters": [
          {
            "description": "Whose shares to end",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovedSharesResponse"
                }
              }
            },
            "description": "How many were ended"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "May not delete every share, or authenticated with an API token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No account has that id"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Ends every share one account uploaded.",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "# Errors\n\n`401` when the credentials do not match, `429` when too many attempts have\nfailed, `404` when the instance has no accounts.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "Signed in"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The body is not the shape this expects"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong credentials"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many failed attempts"
          }
        },
        "summary": "Signs in.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "# Errors\n\n`401` when nothing was signed in.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Ends the current session.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password": {
      "patch": {
        "description": "Every other session is ended, and a fresh one is issued so the caller stays\nsigned in where they are. Whoever knew the old password may be holding a\nsession, and changing a password is how a person says they want that to stop.\n\n# Errors\n\n`401` when the current password is wrong, `403` when authenticated with an\nAPI token, `400` when the new password fails the policy.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "Changed; other sessions ended"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The new password fails the policy"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The current password is wrong"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not permitted with an API token"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Changes the caller's password.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "description": "# Why this always answers the same way\n\n`202` whether or not the address belongs to an account, and whether or not\nthe mail could be handed to the relay. Any other shape turns this endpoint\ninto a way of asking \"does this person have an account here\" — which for a\nfile courier is a question about who uses it, answerable by anyone, at any\nrate the throttle allows.\n\nThe cost is that a typo produces no feedback. That is the right way round:\nsomebody who mistyped their own address will notice when no mail arrives,\nand nobody learns anything from the response either way.\n\n# Errors\n\n`404` when this instance sends no mail — the route is not mounted at all, so\nthis is the router's answer rather than the handler's. `429` when this\naddress has already been sent as many links as the window allows.",
        "operationId": "request_password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted; a link is sent if that address has an account"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The body is not the shape this expects"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance sends no mail"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many links have been sent to this address"
          }
        },
        "summary": "Sends a password reset link, if there is an account and mail is configured.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "description": "Every session belonging to the account is ended. Somebody asking to reset a\npassword is usually saying they have lost control of it, and leaving the\nsessions alone would leave whoever had it signed in.\n\n# Errors\n\n`400` when the token is unknown, spent or expired, or the new password fails\nthe policy. `404` when this instance sends no mail.",
        "operationId": "confirm_password_reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password set; every session ended"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The link is not usable, or the password fails the policy"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance sends no mail"
          }
        },
        "summary": "Sets a new password from a reset link.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "# Errors\n\n`404` when the instance has no accounts, `403` when registration is closed,\n`409` when the name or address is taken, `400` when a value fails its rule.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "Account created and signed in; only where this instance sends no mail"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "default": null
                }
              }
            },
            "description": "Accepted; a confirmation link is sent if that address is free"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A value failed its rule"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Registration is closed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "That username is taken"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many messages have been sent to this address"
          }
        },
        "summary": "Creates an account and signs it in.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register/confirm": {
      "post": {
        "description": "# Why the checks happen here and not when the link was sent\n\nNothing was reserved while the message sat in an inbox. Reserving the name\nwould have made \"register and never confirm\" a free way to lock every good\nname away, with nothing an operator could do about it. The price is this:\nthe name is checked against today's accounts, and somebody can be told at\nthis point that it went to another person. That is rare, it is recoverable,\nand it is a much smaller problem than the alternative.\n\n# Errors\n\n`400` when the link is unknown, spent or expired, `403` when registration was\nclosed while this was waiting, `409` when the name went to somebody else in\nthe meantime, `404` when this instance sends no mail.",
        "operationId": "confirm_registration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "Account created and signed in"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The link is not usable, or the body is not the shape this expects"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Registration was closed while this link was waiting"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance sends no mail"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name was taken while this was waiting"
          }
        },
        "summary": "Turns a confirmed registration into an account.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in.",
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "The signed-in account"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Reports who the caller is.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "description": "Answers to everyone, signed in or not — a client needs this before it can\nknow whether logging in is even possible. An administrator gets one extra\nfield; see [`Capabilities::storage_remaining_bytes`].\n\n# Errors\n\nOnly when the storage total cannot be read, which is an administrator's\nrequest against a database that is not answering.",
        "operationId": "capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "What this instance exposes"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          },
          {}
        ],
        "summary": "Reports which optional parts of the service this instance exposes.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/sessions": {
      "delete": {
        "description": "The button somebody presses when they think another person is signed in as\nthem. It spares the browser doing the asking, because being logged out by\nyour own attempt to log everybody else out is a poor way to find out it\nworked.\n\n# Errors\n\n`401` when nothing was signed in, `403` when a bearer token was used.",
        "operationId": "revoke_other_sessions",
        "responses": {
          "204": {
            "description": "Every other session is over"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token, or a password change is due"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Ends every session except the one asking.",
        "tags": [
          "sessions"
        ]
      },
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when a bearer token was used or the\naccount still owes a password change.",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The caller's sign-ins"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token, or a password change is due"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Lists the caller's sign-ins, newest first.",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/sessions/{id}": {
      "delete": {
        "description": "# Why an identifier that is not yours is a `404`\n\nThe same answer as one that never existed, and as one that is not an\nidentifier at all. Telling them apart would make this endpoint a way to ask\nwhich identifiers exist and who they belong to.\n\n# Why a session that had already finished is a `204`\n\nThe caller asked for it to stop working, and it does not work. Answering\n`404` for a row they can see in their own list would be a puzzle, and would\nmean a list that went stale between loading and clicking reports a problem\nwhere there is none. Nothing is written, so the time it ended does not move.\n\n# Errors\n\n`401` when nothing was signed in, `403` when a bearer token was used, `404`\nwhen no session of the caller's has that identifier.",
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Which session to end",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "It no longer works"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token, or a password change is due"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No session of yours has that id"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Ends one of the caller's sessions.",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/shares": {
      "get": {
        "description": "# Why this is paged\n\nIt was not, on the reasoning that one person's shares are bounded by what\none person uploaded. That holds for somebody using the web page and not for\nanybody driving the API from a script: an account with fifty thousand\nshares made every visit to the listing read fifty thousand rows and build\nfifty thousand responses, and nothing in the request said so.\n\n# Errors\n\n`401` when nothing was signed in.",
        "operationId": "list_shares",
        "parameters": [
          {
            "description": "How many to return. Capped, and defaulted when omitted.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "How many to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharePage"
                }
              }
            },
            "description": "A page of the caller's shares"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`limit` or `offset` is not a number"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The credential does not carry `shares:read`"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Lists the caller's shares, newest first.",
        "tags": [
          "shares"
        ]
      },
      "post": {
        "description": "# Errors\n\n`401` when the instance requires an account to upload, `400` when a parameter\nis unusable, `413` when the body exceeds the configured limit, `409` when no\nunused code could be found.",
        "operationId": "create_share",
        "parameters": [
          {
            "description": "Original file name. Its presence is what makes this a file share rather\nthan a note.",
            "example": "project.zip",
            "in": "query",
            "name": "filename",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Display name, shown on the share page and in the link preview.",
            "example": "Q3 report",
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Syntax-highlighting hint for a text share.",
            "example": "typescript",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How long the share should last. Omit to use the instance's default.",
            "example": 24,
            "in": "query",
            "name": "expires_in_hours",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "How many times it may be retrieved. Omit for unlimited; `1` is\nburn-after-reading.",
            "example": 3,
            "in": "query",
            "name": "max_uses",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/ShareBody"
              }
            }
          },
          "description": "The content itself. Send the file as the raw body — no wrapper, no encoding.",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                }
              }
            },
            "description": "Created",
            "links": {
              "delete": {
                "operationId": "delete_share",
                "parameters": {
                  "code": "$response.body#/code"
                }
              },
              "describe": {
                "operationId": "describe_share",
                "parameters": {
                  "code": "$response.body#/code"
                }
              },
              "unlock": {
                "operationId": "unlock_share",
                "parameters": {
                  "code": "$response.body#/code"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A parameter is unusable"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance requires an account to upload"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The credential does not carry `shares:create`"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Body exceeds the configured limit"
          },
          "507": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance is out of room"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Creates a share from the request body.",
        "tags": [
          "shares"
        ]
      }
    },
    "/api/v1/shares/{code}": {
      "delete": {
        "description": "Accepts either the owning account or, for an anonymous share, the management\ntoken from creation — sent as `X-Share-Management-Token`.\n\n# Errors\n\n`404` when no share of the caller's has that code. Deliberately the same\nanswer as \"somebody else's\": distinguishing them would confirm which codes\nexist.",
        "operationId": "delete_share",
        "parameters": [
          {
            "description": "The retrieval code. Normalised before it is looked up, so O reads as 0, I and L read as 1, case is folded, and spaces and hyphens are dropped — `0ZPQ4M7K`, `ozpq-4m7k` and `OZPQ4M7K` are the same share.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No share of yours has that code"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Deletes a share, and whatever it put in the blob store.",
        "tags": [
          "shares"
        ]
      },
      "get": {
        "description": "This is what the share page reads to decide what to render. It never\nconsumes, so a link preview, a prefetch or a mail-scanner following the URL\ncannot destroy a one-time share.\n\n# Errors\n\n`404` when nothing has that code, `410` when it has expired or run out,\n`401` when it is password-protected and the password given was wrong.",
        "operationId": "describe_share",
        "parameters": [
          {
            "description": "The retrieval code. Normalised before it is looked up, so O reads as 0, I and L read as 1, case is folded, and spaces and hyphens are dropped — `0ZPQ4M7K`, `ozpq-4m7k` and `OZPQ4M7K` are the same share.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The share's password, if it has one",
            "in": "header",
            "name": "X-Share-Password",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicShareResponse"
                }
              }
            },
            "description": "What this share is"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong password"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such code"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Expired or exhausted"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many lookups or password attempts"
          }
        },
        "summary": "Describes a share without spending one of its retrievals.",
        "tags": [
          "shares"
        ]
      },
      "patch": {
        "description": "# Why this exists\n\nEverything here could be decided at creation and nothing could be changed\nafterwards, which is the state this replaces. It does not survive contact\nwith how people actually share a file: the link goes out, and then the\nreason for the expiry changes — the meeting moved, the recipient asks for\nanother day, the wrong person was in the thread and the password has to\nchange now rather than by deleting and re-uploading.\n\n# Who may\n\nThe same two answers as `DELETE`: the owning account, or whoever holds the\nmanagement token an anonymous upload was given. The permission checked is\n`shares:delete` — there is no `shares:update` today, and gating a change\nbehind the right to remove the thing outright is the conservative reading\nwhile there is not.\n\n# Errors\n\n`400` for a value the instance will not accept, `404` when no share of the\ncaller's has that code — deliberately the same answer as somebody else's,\nbecause distinguishing them would confirm which codes exist.",
        "operationId": "update_share",
        "parameters": [
          {
            "description": "The retrieval code. Normalised before it is looked up, so O reads as 0, I and L read as 1, case is folded, and spaces and hyphens are dropped — `0ZPQ4M7K`, `ozpq-4m7k` and `OZPQ4M7K` are the same share.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The token an anonymous upload was given",
            "in": "header",
            "name": "X-Share-Management-Token",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "A new password for the share",
            "in": "header",
            "name": "X-Share-Password",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchShareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                }
              }
            },
            "description": "The share as it now stands"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A setting the instance will not accept"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No share of yours has that code"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Changes a share's settings after it exists.",
        "tags": [
          "shares"
        ]
      }
    },
    "/api/v1/shares/{code}/events": {
      "post": {
        "description": "# Why retrieval is not accepted here\n\n`use_count` is a limit. A client that could report its own retrievals would\nbe a client deciding whether the limit applied, and one `curl` at\n`/s/{code}/raw` would walk past it. The server counts that itself, on the\ntransfer path, where it cannot be skipped.\n\nThese two are the opposite case: nothing reaches the server when somebody\nreads a note on screen or presses a copy button, so a client is the only\nthing that can see them at all. The price is that anybody who can call this\ncan inflate them, which is tolerable precisely because nothing depends on\nthem.\n\n# Why it does not say whether the share exists\n\n`204` whatever happens, including for a code that names nothing. Answering\n`404` would make an unauthenticated endpoint into a way to ask which codes\nare real — the same oracle the retrieval throttle exists to close, reached\nthrough a door nobody was watching.\n\n# Errors\n\n`400` when `kind` is not one of the two, `429` when the source is asking too\noften.",
        "operationId": "record_share_event",
        "parameters": [
          {
            "description": "The share's retrieval code",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Recorded, or the code names nothing"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`kind` is not `view` or `copy`"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many events from this source"
          }
        },
        "security": [
          {}
        ],
        "summary": "Records something a client saw that the server could not.",
        "tags": [
          "shares"
        ]
      }
    },
    "/api/v1/shares/{code}/files": {
      "post": {
        "description": "# Why files arrive one at a time\n\nOne request carrying five files is one request that loses five when it drops\nat the fourth — which is the case somebody uploading a folder of photographs\non a home connection hits, not a theoretical one. A file that fails here is\nretried on its own.\n\n# Why the share exists before its second file\n\nThere is no draft state. A share is created by its first file and grown by\nthe rest, so nothing has to remember to finish, and an upload interrupted\nhalf way leaves a share holding what did arrive rather than nothing at all.\n\nThe cost is that somebody who opened the link during the upload would see\npart of it. The link is handed out after the upload, by the person doing it.\n\n# Errors\n\n`403` when the caller cannot show it is theirs, `404` when no share has that\ncode, `409` when the share holds text, `413` when the body is too large,\n`507` when the instance is out of room.",
        "operationId": "add_share_file",
        "parameters": [
          {
            "description": "The share to add to",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "What to call this file.",
            "example": "holiday.jpg",
            "in": "query",
            "name": "filename",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "items": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              }
            }
          },
          "description": "The file",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                }
              }
            },
            "description": "The share as it now stands"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not yours"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such share"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "That share holds text"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Body exceeds the configured limit"
          },
          "507": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance is out of room"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Adds another file to a share.",
        "tags": [
          "shares"
        ]
      }
    },
    "/api/v1/shares/{code}/unlock": {
      "post": {
        "description": "# Why this is a separate step\n\nOne authorisation costs one retrieval; the ticket it returns is then good for\nevery request the transfer needs — each `Range`, each resumption, each retry.\nCounting requests instead would let a resumed download spend three uses of a\nshare that allows three.\n\n# Errors\n\n`401` when the password is wrong, `404` when nothing has that code, `410`\nwhen it has expired or run out.",
        "operationId": "unlock_share",
        "parameters": [
          {
            "description": "The retrieval code. Normalised before it is looked up, so O reads as 0, I and L read as 1, case is folded, and spaces and hyphens are dropped — `0ZPQ4M7K`, `ozpq-4m7k` and `OZPQ4M7K` are the same share.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The share's password, if it has one",
            "in": "header",
            "name": "X-Share-Password",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            },
            "description": "Authorised"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong password"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such code"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Expired or exhausted"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many lookups or password attempts"
          }
        },
        "summary": "Spends one retrieval and returns a ticket for the transfer.",
        "tags": [
          "shares"
        ]
      }
    },
    "/api/v1/tokens": {
      "get": {
        "description": "# Errors\n\n`401` when nothing was signed in — which is also what an instance with\naccounts turned off answers, since there is nobody to be. `403` when the\naccount still owes a password change.",
        "operationId": "list_tokens",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The caller's tokens"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A password change is due"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Lists the caller's tokens, newest first.",
        "tags": [
          "tokens"
        ]
      },
      "post": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when authenticated with a token\nrather than a session, `400` when the name or lifetime is unusable.",
        "operationId": "create_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTokenResponse"
                }
              }
            },
            "description": "Issued; the secret is shown only here"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name or lifetime is unusable"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token, or a password change is due"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Issues a token and returns its secret, once.",
        "tags": [
          "tokens"
        ]
      }
    },
    "/api/v1/tokens/{id}": {
      "delete": {
        "description": "# Errors\n\n`401` when nothing was signed in, `403` when authenticated with a token,\n`404` when no live token of the caller's has that id.",
        "operationId": "revoke",
        "parameters": [
          {
            "description": "The token's identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Authenticated with an API token, or a password change is due"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No live token of yours has that id"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Revokes one of the caller's tokens.",
        "tags": [
          "tokens"
        ]
      }
    },
    "/api/v1/uploads": {
      "post": {
        "description": "# Errors\n\n`400` when `Upload-Length` is missing or unusable, `403` when the caller may\nnot upload, `404` when `code` names no share, `507` when the declared length\ndoes not fit in what is left of the instance.",
        "operationId": "create_upload",
        "parameters": [
          {
            "description": "What to call the file.",
            "example": "holiday.mp4",
            "in": "path",
            "name": "filename",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Retrieval code of the share to append to.\n\nOmit to make a new share when the upload finishes.",
            "example": "4GSVV6QT",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "The session"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`Upload-Length` missing or unusable"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not allowed to upload"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No share has that code"
          },
          "507": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "This instance has no room for it"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Opens a session.",
        "tags": [
          "uploads"
        ]
      }
    },
    "/api/v1/uploads/{id}": {
      "head": {
        "description": "# The answer must not be cached\n\nIt carries `Cache-Control: no-store`, and a client that caches it anyway\nwill corrupt the upload: a stale offset sends the next chunk to the wrong\nplace, and the bytes land somewhere nobody asked for. This is the one header\non this endpoint that is not politeness.\n\n# Errors\n\n`404` when there is no such session, or the caller may not continue it —\nthe same answer, so that a stranger cannot tell one from the other.",
        "operationId": "upload_offset",
        "parameters": [
          {
            "description": "The session",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`Upload-Offset` says how much has arrived"
          },
          "404": {
            "description": "No such session"
          },
          "410": {
            "description": "That session was abandoned"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Answers how much has arrived.",
        "tags": [
          "uploads"
        ]
      },
      "patch": {
        "description": "# Every chunk but the last must be a whole part\n\n`part_size` from the `POST` is a floor, not a suggestion: a chunk that is\nnot the last and carries fewer bytes than that is refused with `400`. The\nobject stores this streams to will not take a part below their own minimum\n— five mebibytes on S3 — so a short chunk cannot be written anywhere, and\nthe offset does not move. A client that kept sending one would re-send from\nthe same place for ever.\n\nThe last chunk is exempt, because there is nothing after it to make it whole.\n\nA client that sends `declared_bytes` in one request never meets this at all.\n\n# Errors\n\n`400` when a chunk that is not the last is shorter than `part_size`, `409`\nwhen the offset does not match, `404` when there is no such session, `415`\nwhen the content type is not the one the specification names.",
        "operationId": "append_to_upload",
        "parameters": [
          {
            "description": "The session",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/offset+octet-stream": {
              "schema": {
                "items": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              }
            }
          },
          "description": "The next bytes",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                }
              }
            },
            "description": "That was the last of it"
          },
          "204": {
            "description": "Accepted; `Upload-Offset` says the new total"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such session"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The offset does not match"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong content type"
          }
        },
        "security": [
          {},
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Applies bytes at the given offset.",
        "tags": [
          "uploads"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Deliberately both a liveness and a readiness probe: the process only reaches\n[`ServiceStatus::Ready`] once migrations have run, and it flips to\n[`ServiceStatus::Draining`] the moment a shutdown signal arrives, so an\norchestrator can stop routing before the listener actually closes.\n\n# Errors\n\nReturns [`Error::Unavailable`] (503) while starting up or draining, and when\nthe database round-trip fails.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "The service is ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Starting up, draining, or a dependency is unreachable"
          }
        },
        "summary": "Reports whether the service is ready to take traffic.",
        "tags": [
          "system"
        ]
      }
    }
