{
  "name": "tessera",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:web": "turbo run dev -F web",
    "dev:admin": "turbo run dev -F admin",
    "dev:tui": "turbo run dev -F tui",
    "server:dev": "set -a; [ -f ./.dev/local.env ] && . ./.dev/local.env; set +a; cargo run --bin tessera-server",
    "dev:fakes": "cargo run -q -p tessera-dev",
    "server:dev:fakes": "set -a; . ./.dev/fakes.env; [ -f ./.dev/local.env ] && . ./.dev/local.env; set +a; cargo run --bin tessera-server",
    "server:build": "cargo build --release --bin tessera-server",
    "server:test": "cargo nextest run --workspace",
    "server:test:backends": "cargo nextest run --run-ignored all -E 'binary(backends)'",
    "server:fmt": "cargo +nightly fmt --all",
    "server:lint": "cargo +nightly fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "server:doc": "cargo doc --workspace --no-deps --all-features --document-private-items",
    "server:audit": "cargo deny check && cargo machete",
    "server:openapi": "cargo run --bin tessera-openapi",
    "web:api:generate": "pnpm --filter @tessera/api generate",
    "server:check": "pnpm server:lint && pnpm server:test && pnpm server:doc && pnpm server:audit",
    "server:docker": "docker build -f apps/server/Dockerfile --build-arg TESSERA_BUILD_REV=$(git describe --always --dirty --abbrev=12) -t tessera-server .",
    "docker:build": "TESSERA_BUILD_REV=$(git describe --always --dirty --abbrev=12) docker compose build",
    "docker:up": "TESSERA_BUILD_REV=$(git describe --always --dirty --abbrev=12) docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "docs:update": "git submodule update --remote apps/docs"
  },
  "dependencies": {
    "@tessera/env": "workspace:*"
  },
  "devDependencies": {
    "@tessera/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0"
}
