# tessera — example settings for a personal instance
#
# The situation: on your own NAS or home server, reachable only by you (and
# people you trust), usually on the LAN or behind a VPN. You want to throw
# anything at it and there is nobody much to defend against.
#
# How to use it:
#   docker    paste into the `environment:` block of your compose file
#   systemd   save as /etc/tessera/tessera.env and point the unit's
#             EnvironmentFile= at it
#
# It is short on purpose. Anything not listed keeps its built-in default, and
# **nothing that can be changed while the server runs is here**: that lives in
# the admin panel, where a change applies to the next request.

# ══════════════════════════════════════════════════════════════════════
# The only things that cannot change once it is running
# ══════════════════════════════════════════════════════════════════════

# In a container, bind 0.0.0.0, or only the container itself can connect.
# Running directly on the host behind a reverse proxy, 127.0.0.1 is safer.
TESSERA_SERVER__HOST=0.0.0.0
TESSERA_SERVER__PORT=8787

# You are both the developer and the operator, so the API reference is handy.
# Its renderer loads from a CDN in your browser; the server fetches nothing.
TESSERA_FEATURES__DOCS=true

TESSERA_DATABASE__URL=sqlite://data/tessera.db

# The key file (secret.key) and the first storage backend (blobs/) live here.
# To move to S3, B2 or MinIO, add a backend in the admin panel, or with
# `tessera-server backends add`.
TESSERA_SERVER__DATA_DIR=data


# ══════════════════════════════════════════════════════════════════════
# Everything else: in the admin panel, or `tessera-server settings set`
# ══════════════════════════════════════════════════════════════════════
#
# The panel applies a change at once. `settings set` writes the same table but
# is read when the server next starts.
#
# Suggested values for personal use:
#
#   settings set features.anonymous_upload true
#       Upload without signing in. Only you can reach this machine, and
#       signing in every time gets old. (Already the default.)
#       ⚠ If the internet can reach this machine, turn it off, or use
#         tessera.public.env.example instead.
#
#   settings set auth.registration closed
#       No sign-ups. Add accounts yourself in the admin panel if you need more.
#       The default is open.
#
#   settings set share.default_expiry_hours 720
#       The lifetime when none is given. Personal uploads are often "keep it
#       here for now", so this is longer than the default week.
#
#   settings set share.max_expiry_hours 8760
#       The longest lifetime anyone can ask for. A year; it is your disk.
#
#   settings set share.retain_after_death_hours 168
#       How long a share is kept after it expires or runs out of downloads
#       before it is really deleted. A week leaves room to recover a mistake.
#       ⚠ Lowering this deletes things that were going to be kept. The admin
#         panel shows how many shares and how many bytes first.
#
# A personal instance rarely needs quotas, but if you made accounts for
# friends:
#
#   tessera-server quota set role member 10737418240
#       Each member holds at most 10 GB.
#   tessera-server quota set user someone 53687091200
#       Give one person 50 GB without a role of their own.
#       An account's own figure beats its role's. `none` clears it and falls
#       back to the role; `0` means no limit at that layer.
#       storage.max_total_bytes still caps the instance on top of both.
