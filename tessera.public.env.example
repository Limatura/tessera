# tessera — 開放給不特定人使用的範例設定
#
# 情境:架在公網上,任何人都能上傳。你不認識使用者,也不會想認識。
# 每一項都比個人用的緊,因為這台的每一個資源都是陌生人在花。
#
# 用法:
#   docker    貼進 compose 的 environment: 區塊
#   systemd   存成 /etc/tessera/tessera.env,unit 檔寫 EnvironmentFile= 指過來
#
# ⚠ 上線前先讀最下面「還沒有的東西」那段。有一件事現在沒辦法用設定解決,
#    在它做出來之前,這台需要外部的防護。

# ══════════════════════════════════════════════════════════════════════
# 這裡只放「跑起來之後改不了」的設定
# ══════════════════════════════════════════════════════════════════════
#
# socket 已經 bind、連線池已經建好、log subscriber 開機裝一次——這幾類
# 換掉也不會生效,所以它們在這裡。
#
# 其餘 50 個設定在後台改,改完下一個請求就生效,不用重啟。這個檔案裡
# 找不到 share.code_length 之類的東西不是漏了,是它不該在這裡。
# 沒有後台的話用 CLI:tessera-server settings set <key> <value>

# ── 監聽 ──────────────────────────────────────────────────────────────
TESSERA_SERVER__HOST=0.0.0.0
TESSERA_SERVER__PORT=8787

# 25 MiB。陌生人上傳的東西沒有理由給到預設的 100 MiB。
# 這個值被 axum 的 body limit layer 在建 router 時讀走,所以改了要重啟。
TESSERA_SERVER__MAX_BODY_BYTES=26214400

# 前端跟後端同源的話留空。分開部署才需要列出來。
TESSERA_SERVER__CORS_ALLOWED_ORIGINS=

# 對外的機器不需要把 API 參考頁掛出來。openapi.json 照樣提供。
TESSERA_FEATURES__DOCS=false

# ── 資料庫 ────────────────────────────────────────────────────────────
# 單機 SQLite 就夠。要跑多個實例才需要 Postgres。
# ⚠ 這一行帶密碼的話,檔案權限記得 chmod 600。
TESSERA_DATABASE__URL=sqlite://data/tessera.db

# ── 儲存 ──────────────────────────────────────────────────────────────
# 本機路徑,或 s3:// / gs:// / az:// 的 URL(裡面可能帶金鑰,同上)。
TESSERA_STORAGE__URL=data/blobs

# ── log ──────────────────────────────────────────────────────────────
# 對外的機器通常會把 log 收進 Loki / ELK。
TESSERA_TELEMETRY__FORMAT=json
TESSERA_TELEMETRY__ANSI=false
TESSERA_TELEMETRY__FILTER=info

# ── 第一個管理員 ──────────────────────────────────────────────────────
# 留空是「產一組、印一次到 log」,那是比較友善也比較安全的預設:寫進
# compose 檔或環境變數的密碼,傾向於留在那裡而且不會被改。
# TESSERA_AUTH__ADMIN_PASSWORD=


# ══════════════════════════════════════════════════════════════════════
# 以下在後台改(或 tessera-server settings set)
# ══════════════════════════════════════════════════════════════════════
#
# 對外機器的建議值。不是預設值,要自己設。
#
#   settings set features.anonymous_upload true
#       這台存在的意義就是讓人不用註冊就能傳東西。
#
#   settings set features.admin false
#       關掉管理端點,除非你真的要從瀏覽器管這台。
#       ⚠ 關掉之後只剩 CLI 能改設定。
#
#   settings set auth.registration closed
#       不開放註冊。要開放的話註冊政策要跟配額一起想。
#
#   settings set auth.session_ttl_hours 168
#
#   settings set share.code_length 10
#       10 碼而不是 8。取件碼端點暴露在公網上可以被枚舉,雖然有節流,
#       但碼長一點的成本是零。
#
#   settings set share.default_expiry_hours 72
#       沒指定期限時用這個,也就是絕大多數的分享。短期儲存不會累積——
#       你手上握著的量等於「每天上傳量 × 保存天數」,所以這一個數字對
#       磁碟用量的影響比任何東西都大,包括配額。
#
#   settings set share.max_expiry_hours 168
#   settings set share.retain_after_death_hours 24
#       過期或取完就快點清掉,別替陌生人保管。
#       ⚠ 調小這個會刪掉本來要留的東西。後台會先算給你看幾筆、多少 GB。
#
#   settings set share.ticket_ttl_hours 6
#       解鎖之後那張 ticket 能用多久。對外的機器縮短一點,因為 ticket
#       可以被轉給別人(見 #45)。
#
#   settings set storage.max_total_bytes 53687091200
#       這台總共最多握著多少內容。0 是不限。
#       沒有這個的話,匿名上傳開著就等於一顆任何人都能填滿的硬碟,而且
#       第一個徵兆是寫入開始失敗——那是最糟的發現時機。50 GB 只是一個
#       起點,照你的磁碟改。
#       只算還存在的內容:已經死掉、只留一列用來回答「這個過期了」的
#       分享,位元組在死掉當下就清掉了,不佔額度。
#
#   tessera-server quota set role guest 21474836480
#       但上面那個是整台的總量,擋不住「一個陌生人把全部塞滿」。
#       匿名上傳算在 guest 這個角色底下,所以給 guest 一個額度,就等於
#       「開放大家傳,但全部匿名的加起來不能超過 20 GB」。
#       登入的人算在自己的角色,不受影響。
#       這個不是設定,是資料表,所以是 quota 不是 settings。後台也能改。

#   tessera-server quota set-file role guest 26214400
#       單一檔案最大 25 MiB,只針對 guest。
#       TESSERA_SERVER__MAX_BODY_BYTES 是全站一個數字而且要重啟,所以
#       你為了自己方便調大,陌生人就跟著能傳那麼大。這一行讓你只放寬
#       自己(或某個角色),不放寬陌生人。
#       上面那個環境變數還是壓在最上面,這裡只能調小不能調大。
#
#   settings set server.trusted_proxies '["127.0.0.1","::1"]'
#       前面有 nginx / Caddy / Cloudflare 的話,把它的位址列在這裡,
#       節流才看得到真實來源 IP。
#       ⚠ 要寫代理自己的位址,不是使用者的。列錯或列太寬(例如
#          0.0.0.0/0)等於讓任何人自己宣稱自己的 IP,節流就完全失效。
#          同一台機器上的代理是 127.0.0.1;docker compose 裡的是那個網段。


# ══════════════════════════════════════════════════════════════════════
# 還沒有的東西
# ══════════════════════════════════════════════════════════════════════
#
# 這件事目前沒有任何設定可以打開,在做出來之前,對外的機器要靠外部手段補:
#
#   惡意軟體掃描(#39)—— 現在完全不掃。匿名 + 免註冊 + 不掃描,對營運者
#                        是真實的法律與濫用風險。
#                        暫時的做法:前面擋一層,或接受這個風險並準備好
#                        處理檢舉。
