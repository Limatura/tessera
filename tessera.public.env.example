# tessera — example settings for an instance open to strangers
#
# The situation: on the public internet, and anyone can upload. You do not
# know your users and do not want to. Everything here is tighter than the
# personal example, because every resource on this machine is spent by
# strangers.
#
# How to use it:
#   docker    paste into the `environment:` block of your compose file
#   systemd   save as /etc/tessera/tessera.env and point the unit's
#             EnvironmentFile= at it

# ══════════════════════════════════════════════════════════════════════
# Only what cannot change once it is running
# ══════════════════════════════════════════════════════════════════════
#
# The socket is bound, the connection pool built and the log subscriber
# installed once at startup, so changing these later has no effect.
#
# Every other setting lives in the admin panel, where a change
# applies to the next request without a restart. Not finding
# share.code_length here is not an oversight; it does not belong here.
# Without the panel, use the CLI: tessera-server settings set <key> <value>

# ── Listening ─────────────────────────────────────────────────────────
TESSERA_SERVER__HOST=0.0.0.0
TESSERA_SERVER__PORT=12923

# 25 MiB. There is no reason to give strangers the default 100 MiB.
# Read when the router is built, so changing it needs a restart.
TESSERA_SERVER__MAX_BODY_BYTES=26214400

# Leave empty when the web app is served from the same origin, which it is
# unless you deploy it separately.
TESSERA_SERVER__CORS_ALLOWED_ORIGINS=

# A public machine has no need to show the API reference. openapi.json is
# served either way.
TESSERA_FEATURES__DOCS=false

# ── Database ──────────────────────────────────────────────────────────
# SQLite is enough for one machine. PostgreSQL is for running several.
# ⚠ If this line carries a password, chmod 600 the file.
TESSERA_DATABASE__URL=sqlite://data/tessera.db

# ── Data directory ────────────────────────────────────────────────────
# On first start the server puts secret.key here (it seals the passwords and
# bucket keys stored through the panel), and blobs/.
# Add storage backends in the panel, or with `tessera-server backends add`.
TESSERA_SERVER__DATA_DIR=data

# To keep the key out of backups of the data directory, set your own
# (openssl rand -hex 32).
# ⚠ Never change it once set: stored passwords and backends would no longer
#   open.
# TESSERA_SECURITY__SECRET_KEY=

# ── Logs ──────────────────────────────────────────────────────────────
# A public machine usually ships its logs to Loki, ELK or similar.
TESSERA_TELEMETRY__FORMAT=json
TESSERA_TELEMETRY__ANSI=false
TESSERA_TELEMETRY__FILTER=info

# ── First administrator ───────────────────────────────────────────────
# Left empty, a password is generated and printed to the log once. That is
# the friendlier and safer default: a password written into a compose file or
# an environment tends to stay there and never be changed.
# TESSERA_AUTH__ADMIN_PASSWORD=


# ══════════════════════════════════════════════════════════════════════
# The rest: in the admin panel, or `tessera-server settings set`
# ══════════════════════════════════════════════════════════════════════
#
# Suggested values for a public machine. These are not the defaults; set
# them yourself. The panel applies a change at once; `settings set` is read
# when the server next starts.
#
#   settings set features.anonymous_upload true
#       The point of this machine: send something without signing up.
#
#   settings set features.admin false
#       Turn the admin endpoints off, unless you will run this machine from
#       a browser.
#       ⚠ With it off, only the CLI can change settings.
#
#   settings set auth.registration closed
#       No sign-ups (the default is open). If you open them, decide on quotas
#       at the same time.
#
#   settings set auth.session_ttl_hours 168
#
#   settings set share.code_length 10
#       10 characters instead of 8. The code lookup is on the public internet
#       and can be enumerated; it is throttled, but a longer code costs
#       nothing.
#
#   settings set share.default_expiry_hours 72
#       The lifetime when none is given, which is most shares. Short-lived
#       storage does not pile up: what you hold is roughly daily uploads
#       times days kept, so this one number moves disk usage more than
#       anything else, quotas included.
#
#   settings set share.max_expiry_hours 168
#   settings set share.retain_after_death_hours 24
#       Clean up quickly once a share has expired or run out. Do not keep
#       things for strangers.
#       ⚠ Lowering this deletes things that were going to be kept. The admin
#         panel shows how many shares and how many bytes first.
#
#   settings set share.ticket_ttl_hours 6
#       How long the ticket from unlocking a password-protected share lasts.
#       Shorter on a public machine, because a ticket can be handed on.
#
#   settings set storage.max_total_bytes 53687091200
#       The most content the whole instance may hold. 0 is no limit.
#       Without it, anonymous uploads make a disk anyone can fill, and the
#       first sign is writes starting to fail, the worst time to find out.
#       50 GB is only a starting point; size it to your disk.
#       Only live content counts: a share that has ended and is kept only to
#       answer "this has expired" freed its bytes when it ended.
#
#   tessera-server quota set role guest 21474836480
#       The figure above is the whole instance, so it does not stop one
#       stranger filling all of it. Anonymous uploads are charged to the
#       `guest` role, so a quota on guest means "anyone may upload, but all
#       anonymous uploads together stay under 20 GB". Signed-in people are
#       charged to their own role and are unaffected.
#       Quotas are data, not settings, so this is `quota`, not `settings`.
#       The admin panel can change them too.
#
#   tessera-server quota set-file role guest 26214400
#       The largest single file, 25 MiB, for guests only.
#       TESSERA_SERVER__MAX_BODY_BYTES is one number for everyone and needs
#       a restart, so raising it for your own convenience raises it for
#       strangers too. This lets you allow more to yourself or a role without
#       allowing it to strangers. The environment variable still caps
#       everything; this can only go lower.
#
#   settings set server.trusted_proxies '["127.0.0.1","::1"]'
#       If nginx, Caddy or Cloudflare sits in front, list its address here so
#       throttling sees the real client address.
#       ⚠ List the proxy's own address, not the users'. A wrong or too-wide
#         entry (0.0.0.0/0, say) lets anyone claim any address, and
#         throttling stops working. A proxy on the same machine is
#         127.0.0.1; one in docker compose is that network's range.
#
#   settings set scan.url clamd://clamav:3310
#       Scan uploads for malware before they are handed out. Anonymous,
#       sign-up-free and unscanned is a real legal and abuse risk for an
#       operator. Tessera does not contain a scanner; run ClamAV (the
#       clamav/clamav image) or any HTTP scanner and point this at it.
#       See docs/scanning.md.
#       ⚠ An end-to-end encrypted share cannot be scanned. A machine that
#         must scan everything should leave features.encryption off, which is
#         the default.
