{
  "extends": "@tessera/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@tessera/ui/*": ["./src/*"]
    },
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // `src/components` and `src/hooks` are shadcn output — generated, not authored,
  // and regenerated by `shadcn add` whenever the style changes. Type errors in
  // them are upstream's to fix, and chasing them means editing files that the
  // next `shadcn add --overwrite` throws away. `oxlint.config.ts` already turns
  // its rules off for the same path, for the same reason; this keeps the two
  // agreeing about what is ours.
  //
  // Their *dependencies* are still ours: an import here that is not in
  // package.json breaks a clean install, and that is a packaging bug rather
  // than a style one.
  "exclude": ["node_modules", "src/components/**", "src/hooks/**"]
}
