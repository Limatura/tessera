**/node_modules
.git

**/dist
# ...except the SPA bundle: apps/server compiles it into the binary with
# rust-embed, so it has to reach the build context. Absent, the server embeds a
# placeholder page instead.
!apps/web/dist
**/build
**/.next
**/.nuxt
**/.output
**/.svelte-kit
**/.astro
**/.turbo
.turbo

# Rust build output — several GB, and never useful inside an image layer.
**/target
apps/server/assets/dist

**/.wrangler
**/.alchemy
**/.expo
**/.vercel
*.log

Dockerfile
**/Dockerfile
docker-compose.yml

# Secrets stay out of image layers; runtime env comes from compose env_file,
# build-time public values come from compose build args
**/.env
**/.env.*
!**/.env.example
