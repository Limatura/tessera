{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_ADMIN_*",
        "TESSERA_API_ORIGIN",
        "PLAYWRIGHT_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
